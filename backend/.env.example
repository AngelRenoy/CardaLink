PORT=5000
DATABASE_URL=postgresql://postgres:root@localhost:5432/cardalink_db
JWT_SECRET=cardalink_super_secret_jwt_key_2026
NODE_ENV=development

# Google OAuth 2.0 Identity Provider Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_api_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Frontend Application URL (for generating email confirmation links)
FRONTEND_URL=http://localhost:5173

# Email & SMTP Configuration (Optional: uses console backend in dev if credentials omitted)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CardaLink Exports <no-reply@cardalink.com>
DELIVERY_CONFIRMATION_EXPIRY_HOURS=72
