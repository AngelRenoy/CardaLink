PORT=5000
DATABASE_URL=postgresql://postgres:root@localhost:5432/cardalink_db
JWT_SECRET=cardalink_super_secret_jwt_key_2026
NODE_ENV=development

# Google OAuth 2.0 Identity Provider Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_api_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Frontend Application URL (for generating email confirmation links in buyer emails)
# Local: http://localhost:5173 | Production: https://carda-link.vercel.app
FRONTEND_URL=http://localhost:5173

# Email & SMTP Configuration
# NOTE FOR CLOUD / RENDER DEPLOYMENTS:
# .env is in .gitignore and NOT pushed to Git. You MUST manually add these variables 
# in your Render Dashboard -> Environment tab for emails to send in live!
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=angel.renoy19@gmail.com
# Use 16-character Google App Password (spaces will be stripped automatically)
EMAIL_HOST_PASSWORD=mizy obat cstr dozy
DEFAULT_FROM_EMAIL=CardaLink Exports <angel.renoy19@gmail.com>
DELIVERY_CONFIRMATION_EXPIRY_HOURS=72

# Cloud HTTP Email Provider (Recommended on Render free web services where outbound SMTP ports 25, 465, 587 are blocked)
# Resend provides 3,000 free emails/month via HTTPS port 443 with 0 port blocking: https://resend.com
RESEND_API_KEY=
# Brevo (formerly Sendinblue) provides 300 free emails/day via HTTPS port 443: https://brevo.com
BREVO_API_KEY=

